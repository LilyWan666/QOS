{
  "name": "qos_fig11_full_agent_autorun",
  "description": "Paper-aligned Figure 11 reproduction recipe for the QOS multi-programmer, using simulation-only/offline backend modeling.",
  "workspace_root": ".",
  "paper": {
    "documents": [
      {"label": "qos_main_paper", "path": "paper/qos.pdf"}
    ],
    "focus_terms": [
      "figure 11",
      "multiprogramming",
      "No M/P",
      "Baseline M/P",
      "QOS M/P",
      "effective utilization",
      "relative fidelity",
      "30%",
      "60%",
      "88%"
    ]
  },
  "recipe_authoring": {
    "enabled": false,
    "target_figure_id": "fig11",
    "required_methods": [
      "no_multiprogramming",
      "baseline_multiprogramming",
      "qos_multiprogramming"
    ],
    "required_outputs": [
      "figure_11a",
      "figure_11b",
      "figure_11c"
    ],
    "strict_paper_alignment": true
  },
  "entry": {
    "kind": "command",
    "command": [
      "{python_executable}",
      "evaluation/agent_framework/reproduce/harnesses/run_qos_fig11_full.py",
      "--metrics-path",
      "{metrics_path}",
      "--output-dir",
      "{run_dir}/figures"
    ],
    "timeout_seconds": 900,
    "env": {
      "REPRO_FIG11_THRESHOLD_QUBITS": "8,16,24",
      "REPRO_QPU_NUM_QUBITS": "27",
      "REPRO_FIG11_FULL_24Q_TIMEOUT_BOUNDED": "0",
      "REPRO_AER_METHOD": "matrix_product_state",
      "REPRO_AER_MAX_THREADS": "1",
      "REPRO_AER_SHOTS": "8192",
      "REPRO_FIG11_PAIRS_PER_UTIL": "24",
      "REPRO_FIG11C_MIN_PAIRS_PER_APP": "3",
      "REPRO_FIG11_DEFER_EXPENSIVE_NO_MP_FOR_PROXY": "1",
      "REPRO_NOISE_QPU": "ibm_marrakesh",
      "REPRO_NOISE_2Q_MODE": "layered"
    }
  },
  "preflight": {
    "commands_exist": ["python"],
    "paths_exist": [
      "evaluation/agent_framework/reproduce/harnesses/run_qos_fig11_full.py",
      "evaluation/agent_framework/reproduce/examples/figure_contracts/qos_fig11_full.contract.json",
      "paper/qos.pdf",
      "evaluation/benchmarks",
      "qos/multiprogrammer/multiprogrammer.py",
      "Baseline_Multiprogramming/multiprogramming.py"
    ],
    "python_imports": [],
    "optional_python_imports": ["matplotlib"]
  },
  "parsing": {
    "kind": "json_file",
    "path": "{metrics_path}",
    "required_metric_keys": [
      "success",
      "figure_id",
      "threshold_count",
      "methods_count",
      "summary",
      "output_files"
    ]
  },
  "success_criteria": {
    "require_exit_code_zero": true,
    "require_metrics": true,
    "require_metric_success": true,
    "require_verification_success": true
  },
  "simulation_budget": {
    "strict_timeout_seconds": 900,
    "proxy_on_timeout": true,
    "timeout_recovery": "openevolve_proxy_search",
    "strict_timeout_semantics": "fail_strict_reproduction_then_search_proxy"
  },
  "reproduction_requirements": {
    "original_code_path_required": true,
    "original_code_path": {
      "min_original_modules": 2,
      "forbidden_path_prefixes": [
        "evaluation/agent_framework/reproduce/"
      ],
      "preferred_path_prefixes": [
        "qos/",
        "qvm/",
        "Baseline_Multiprogramming/",
        "evaluation/benchmarks/"
      ],
      "required_modules": [
        "qos.multiprogrammer.multiprogrammer",
        "Baseline_Multiprogramming.multiprogramming",
        "evaluation.benchmarks.circuits",
        "qvm"
      ]
    }
  },
  "verification": {
    "enabled": true,
    "kind": "figure_contract",
    "contract_path": "evaluation/agent_framework/reproduce/examples/figure_contracts/qos_fig11_full.contract.json",
    "output_path": "{run_dir}/figure_verdict.json"
  },
  "evolution": {
    "proxy_search": {
      "enabled": true,
      "training_data_schema": "ibm_torino_physical_pair_records",
      "parameter_profile": {
        "name": "qos_fig11_proxy_multiutil_default",
        "source": "agent_recipe",
        "objective": {
          "name": "physical_validated_pair_selection",
          "selection_target": "multiprogramming_pair_selection",
          "ground_truth_metrics": [
            "effective_utilization",
            "proxy_estimated_fidelity"
          ],
          "aggregation": "selected_topk_average_pareto_rank",
          "primary_score": "inv_avg_pareto_rank",
          "topk_selection": true,
          "diagnostic_metrics": [
            "rank_agreement",
            "top_rank_overlap"
          ],
          "forbid_objective_gating_by_front_overlap": true,
          "forbid_required_rank1_overlap": true,
          "forbid_single_metric_fidelity_only": true,
          "candidate_function": "auto_discovered_qos_target"
        },
        "objective_requirements": {
          "selection_target": "multiprogramming_pair_selection",
          "primary_metric": "effective_utilization",
          "expensive_metric": "ibm_torino.hellinger_mean",
          "direct_metric_source": "physical_qpu_pair_measurement",
          "proxy_policy": "use_proxy_only_when_direct_metric_is_unavailable_or_too_expensive",
          "proxy_role": "pre_evolution_expensive_metric_substitute",
          "aggregation": "selected_topk_average_pareto_rank",
          "primary_score": "inv_avg_pareto_rank",
          "topk_selection": true,
          "diagnostic_metrics": [
            "rank_agreement",
            "top_rank_overlap"
          ],
          "forbid_objective_gating_by_front_overlap": true,
          "forbid_required_rank1_overlap": true
        },
        "settings": {
          "utilization_targets": "30:60:88",
          "multi_util_aggregation": "mean",
          "top_k_ratio": "0.10",
          "eval_shots": "8192",
          "external_pair_csv_allowed": false,
          "proxy_features": "qubit_imbalance,scale_ratio,layout_span,joint_qubits,left_qubits,right_qubits,depth_ratio,depth_density,cnot_ratio,cnot_density,nonlocal_ratio,nonlocal_density,measure_ratio,measure_density,instr_ratio,instr_density,critical_depth_ratio,critical_depth_density",
          "default_proxy_feature": "qubit_imbalance",
          "seed_transfer": "small_to_large",
          "seed_source_policy": "completed_smaller_thresholds",
          "seed_target_policy": "timed_out_larger_thresholds",
          "physical_backend": "ibm_torino",
          "qpu_feedback_split_mode": "holdout_by_util",
          "qpu_feedback_train_utils": "util30,util60",
          "qpu_feedback_validate_utils": "util88",
          "qpu_submission": "manual_only"
        },
        "required_explicit": ["OE_TOP_K_RATIO"],
        "agent_overrides": {
          "OE_EVAL_SHOTS": "8192",
          "OE_RESTRICT_TO_PAIR_CSV": "0",
          "OE_SEED_TRANSFER": "small_to_large",
          "OE_PHYSICAL_BACKEND": "ibm_torino",
          "REPRO_QPU_FEEDBACK_TRAIN_UTILS": "util30,util60",
          "REPRO_QPU_FEEDBACK_VALIDATE_UTILS": "util88"
        }
      }
    }
  },
  "recovery": {
    "mode": "agent_guided",
    "simulation_only": true,
    "handlers": {}
  },
  "metadata": {
    "seed_recipe": false,
    "owner": "reproduce_agent",
    "notes": "This recipe is paper-aligned but simulation-only. It avoids IBM/QPU access and checks structural Figure 11 claims."
  }
}
