{
  "name": "qos_fix_budget_demo",
  "description": "Demo recipe for testing classify/apply-fix budget flow with reproducible preflight failure.",
  "workspace_root": ".",
  "entry": {
    "kind": "command",
    "command": [
      "{python_executable}",
      "-c",
      "print('demo run')"
    ],
    "timeout_seconds": 30
  },
  "preflight": {
    "commands_exist": [
      "python"
    ],
    "paths_exist": [
      "evaluation/agent_framework/reproduce"
    ],
    "python_imports": [
      "definitely_missing_module_for_qos_demo"
    ]
  },
  "parsing": {
    "kind": "json_file",
    "path": "{metrics_path}",
    "required_metric_keys": [
      "success"
    ]
  },
  "success_criteria": {
    "require_exit_code_zero": true,
    "require_metrics": false,
    "require_metric_success": false
  },
  "recovery": {
    "mode": "agent_guided",
    "fix_budget": 2,
    "handlers": {
      "select_or_prepare_python_environment": {
        "command": [
          "{python_executable}",
          "-c",
          "print('demo fix applied')"
        ],
        "timeout_seconds": 30
      }
    }
  }
}
