# QOS-Agent physical QPU job data environment.
# Source this file from the QOS-agent repository root.

export QOS_AGENT_PHYSICAL_QPU_JOBS_ROOT="qpu_env/physical_qpu_jobs"
export QOS_AGENT_PHYSICAL_QPU_JOBS_MANIFEST="qpu_env/physical_qpu_jobs/manifest.json"
export QOS_AGENT_PHYSICAL_QPU_SHOTS="8192"
export QOS_AGENT_PHYSICAL_QPU_METRIC_SOURCE="hellinger_mean"

export QOS_AGENT_MARRAKESH_UTIL30_FIDELITY_DIR="qpu_env/physical_qpu_jobs/ibm_marrakesh/util30/fidelity"
export QOS_AGENT_MARRAKESH_UTIL60_FIDELITY_DIR="qpu_env/physical_qpu_jobs/ibm_marrakesh/util60/fidelity"
export QOS_AGENT_MARRAKESH_UTIL88_FIDELITY_DIR="qpu_env/physical_qpu_jobs/ibm_marrakesh/util88/fidelity"

export QOS_AGENT_TORINO_UTIL30_FIDELITY_DIR="qpu_env/physical_qpu_jobs/ibm_torino/util30/fidelity"
export QOS_AGENT_TORINO_UTIL60_FIDELITY_DIR="qpu_env/physical_qpu_jobs/ibm_torino/util60/fidelity"
export QOS_AGENT_TORINO_UTIL88_FIDELITY_DIR="qpu_env/physical_qpu_jobs/ibm_torino/util88/fidelity"
